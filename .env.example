# Copy this file to .env and fill in your values. Never commit .env.

# Required — your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATION_MODEL=gpt-4o-mini
# CHROMA_DB_PATH=./chroma_db
# EMBEDDING_CACHE_PATH=./embedding_cache.db
# RETRIEVAL_TOP_K=5
# LOG_LEVEL=INFO

# Per-IP rate limit (semicolon-composite, applied via slowapi).
# Default is sized for the public demo — see ADR-0010.
# API_RATE_LIMIT=10/hour;3/minute

# Retrieval strategy: dense | hybrid | hybrid-rerank | hyde | full
# 'full' = HyDE ∘ RerankingRetriever ∘ HybridRetriever (best quality, highest cost)
# hybrid-rerank / full require the [rerank] extra: pip install -e '.[rerank]'
# RETRIEVAL_STRATEGY=dense
# HYBRID_RRF_K=60
# RERANK_ENABLED=false
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATE_MULTIPLIER=4

# Corrective RAG — critic scores each chunk; on low relevance the query is
# reformulated and retried, else the system refuses instead of hallucinating.
# Adds 1-3 extra LLM calls per query; opt in explicitly.
# CORRECTIVE_RAG_ENABLED=false
# CRITIC_CORRECT_THRESHOLD=0.7
# CRITIC_INCORRECT_THRESHOLD=0.3
# CORRECTIVE_MAX_RETRIES=1

# Observability — override built-in per-million-token pricing without editing source.
# Format: JSON dict of "model": [input_rate_usd_per_million, output_rate_usd_per_million]
# MODEL_RATES_OVERRIDES={"gpt-4o-mini": [0.15, 0.60]}

# Per-stage tracing (Arize Phoenix — see ADR-0009). Requires the
# [observability] extra: pip install -e '.[observability]'
# Run Phoenix locally with: docker compose up phoenix (UI on http://localhost:6006)
# TRACING_ENABLED=false
# TRACING_ENDPOINT=http://localhost:6006/v1/traces
# TRACING_SERVICE_NAME=rag-harness

# LLM judge response cache — makes eval reruns and the ablation study near-free.
# Only caches faithfulness/correctness/answer_relevancy/context_precision judges.
# Never caches generate() or the corrective critic (footgun). Delete llm_cache.db
# to invalidate. The `ablation` CLI subcommand default-enables this.
# LLM_CACHE_ENABLED=false
# LLM_CACHE_PATH=./llm_cache.db

# Corpus pin — change only when deliberately upgrading the K8s docs version.
# Current pin: snapshot-initial-v1.32
# K8S_GIT_COMMIT=bbb60b97e9bade8f5bd9cf3c4543243c55a4c0ca
